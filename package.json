{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "deploy:check": "tsx src/backend/scripts/deploymentCheck.ts",
    "db:backup": "tsx src/backend/scripts/backupDatabase.ts",
    "dev": "next dev",
    "dev:full": "prisma generate && prisma migrate deploy && next dev --port=3000 --hostname=0.0.0.0",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "echo \"Use db:migrate:dev or db:migrate:deploy instead of db:push\"",
    "db:studio": "prisma studio",
    "seed:admin": "tsx src/backend/scripts/seedAdmin.ts",
    "worker:prescriptions": "tsx src/backend/scripts/prescriptionEmailWorker.ts",
    "test:medical": "tsx --test tests/medical-profile.test.ts",
    "test:env": "tsx --test tests/environment.test.ts",
    "test:deployment": "tsx --test tests/database-deployment.test.ts",
    "test:ads": "tsx --test tests/ads-runtime.test.ts",
    "test:discovery": "tsx --test tests/donor-discovery.test.ts",
    "test:profile-ui": "tsx tests/profile-ui-check.mjs",
    "test:security": "tsx --test tests/security.test.ts",
    "test:seo": "tsx --test tests/seo-content.test.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1034.0",
    "@google/genai": "^1.29.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.1.14",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.14.2",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.41",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.5.28",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.1.1",
    "pg": "^8.20.0",
    "postcss": "8.5.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.14",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.4.21",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "mysql2": "3.24.6",
    "postcss": "$postcss",
    "esbuild": "0.28.2",
    "qs": "6.16.1"
  }
}
