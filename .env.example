# ----------------------------------------------------
# DATABASE (Required)
# ----------------------------------------------------
# Local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blood_db?schema=public"
DATABASE_URL=""
# Future VPS cutover DSN (optional now)
DATABASE_URL_VPS=""

# ----------------------------------------------------
# JWT AUTH (Required)
# ----------------------------------------------------
# Must be at least 32 characters.
JWT_SECRET=""

# ----------------------------------------------------
# SMTP / OTP EMAIL (Required for OTP login)
# ----------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# ----------------------------------------------------
# ADMIN SEED (Required if you want admin dashboard login)
# ----------------------------------------------------
# Used by: npm run seed:admin
ADMIN_ID=""
ADMIN_PASSWORD=""
# ADMIN or MANAGER
ADMIN_ROLE="ADMIN"

# ----------------------------------------------------
# OPTIONAL CLIENT ENV
# ----------------------------------------------------
NEXT_PUBLIC_MAPBOX_API_KEY=""
GEOAPIFY_API_KEY=""

# ----------------------------------------------------
# Cloudflare R2 Media Storage (future phase)
# ----------------------------------------------------
# If these remain empty, uploads are saved to local: /public/uploads/*
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
