# ====================================================
# BLOODNET ENV SETUP GUIDE
# Copy this file to `.env` and fill values step-by-step.
# ====================================================

# ----------------------------------------------------
# 1) APP MODE + DOMAIN (Required in production)
# ----------------------------------------------------
# development | test | production
NODE_ENV="development"

# Public website URL (used for metadata/canonical links)
# For VPS production: https://bloodnet.live
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional legacy fallback URL field (keep same as above if used)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ----------------------------------------------------
# 2) DATABASE (Required)
# ----------------------------------------------------
# STEP:
# - Current (Neon): paste Neon pooled connection string
# - Later (VPS): replace DATABASE_URL with your VPS DSN after migration
#
# Example local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blood_db?schema=public"
DATABASE_URL=""

# Optional: keep upcoming VPS DSN here for cutover planning
DATABASE_URL_VPS=""

# ----------------------------------------------------
# 3) JWT AUTH (Required)
# ----------------------------------------------------
# STEP:
# Generate a secure secret (64 hex chars) using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be 32+ characters.
JWT_SECRET=""

# ----------------------------------------------------
# 4) SMTP / OTP EMAIL (Required for OTP login)
# ----------------------------------------------------
# Gmail setup steps:
# 1. Enable 2-Step Verification in your Google account.
# 2. Create App Password: Google Account -> Security -> App passwords.
# 3. Use Gmail address in SMTP_USER and app password in SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# ----------------------------------------------------
# 5) ADMIN DASHBOARD LOGIN SEED (Required for admin access)
# ----------------------------------------------------
# Used by: npm run seed:admin
# STEP:
# - Set ADMIN_ID (example: superadmin)
# - Set ADMIN_PASSWORD (strong password)
# - Run: npm run seed:admin
ADMIN_ID=""
ADMIN_PASSWORD=""
# ADMIN or MANAGER
ADMIN_ROLE="ADMIN"

# ----------------------------------------------------
# 6) LOCATION / MAP APIs
# ----------------------------------------------------
# Required now (you are already using this): Geoapify city autocomplete
# Create key: https://myprojects.geoapify.com/ -> API Keys
GEOAPIFY_API_KEY=""

# Optional (currently unused in most flows): Mapbox token
# Create key: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_API_KEY=""

# ----------------------------------------------------
# 7) GLOBAL AUTO LANGUAGE (Optional now, required if enabling live translation)
# ----------------------------------------------------
# Google Cloud Translation API key steps:
# 1. Create/choose GCP project in Google Cloud Console
# 2. Enable "Cloud Translation API"
# 3. Create API key under APIs & Services -> Credentials
# 4. Restrict by API + domain/IP before production
GOOGLE_TRANSLATE_API_KEY=""

# ----------------------------------------------------
# 8) MEDIA STORAGE (Choose one mode)
# ----------------------------------------------------
# MODE A (recommended production): Cloudflare R2 + CDN URL
# MODE B (fallback): local uploads (/public/uploads)
#
# In production, if R2 is empty, set ENABLE_LOCAL_UPLOAD_FALLBACK=true
# (not recommended for long-term scale).
ENABLE_LOCAL_UPLOAD_FALLBACK="true"

# Cloudflare R2 setup steps:
# 1. Cloudflare Dashboard -> R2 -> Create bucket
# 2. Create API token (R2 Object Read/Write)
# 3. Copy Account ID from Cloudflare dashboard
# 4. Set a public base URL (R2 custom domain/CDN URL)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
